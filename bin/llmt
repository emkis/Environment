#!/usr/bin/env bash
# Thin launcher shim: the real implementation lives in packages/llmt/main.ts.
set -euo pipefail

if [ -z "${ENVIRONMENT_REPOSITORY:-}" ]; then
  echo "ENVIRONMENT_REPOSITORY is not set. Set it in config.fish." >&2
  exit 1
fi

exec bun "$ENVIRONMENT_REPOSITORY/packages/llmt/main.ts" "$@"
